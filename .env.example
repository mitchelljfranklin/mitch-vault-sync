# ── MitchVault Sync Configuration ──────────────────────────
# Copy this file to .env and fill in your values.

# ── Vaultwarden (source) ───────────────────────────────────
VAULTWARDEN_URL=https://vault.example.com
VAULTWARDEN_MP=your-master-password

# Auth: email/password (Vaultwarden does not support API keys)
VAULTWARDEN_EMAIL=user@example.com
VAULTWARDEN_PASSWORD=your-password

# ── Bitwarden Cloud (target) ───────────────────────────────
BITWARDEN_CLIENT_ID=user.your-client-id
BITWARDEN_CLIENT_SECRET=your-client-secret

# Server: vault.bitwarden.com (US) or vault.bitwarden.eu (EU)
BITWARDEN_SERVER=https://vault.bitwarden.com

# Master password — required for vault decryption (API key login only authenticates)
BITWARDEN_MP=your-master-password

# ── Scheduling ─────────────────────────────────────────────
# Human-readable: hourly, daily, 12h, 6h, weekly, 7d, "3:00", "3:00 Europe/London"
# Default: daily (every 24 hours from container start)
SYNC_SCHEDULE=daily

# Advanced: raw cron expression (overrides SYNC_SCHEDULE)
# SYNC_CRON="0 2 * * *"

# ── Healthcheck ────────────────────────────────────────────
# Container turns unhealthy when the last successful sync is older than this.
# Keep it above your sync interval; default 48 hours suits SYNC_SCHEDULE=daily.
# HEALTHCHECK_MAX_AGE_HOURS=48

# ── Logging ────────────────────────────────────────────────
# INFO (default) or DEBUG for troubleshooting
LOG_LEVEL=INFO
